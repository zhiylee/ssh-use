# init.sh sets these to the invoking user's IDs (10001:10001 when run as root).
SSH_USE_UID=10001
SSH_USE_GID=10001

# For remote clients, set this to the server's LAN/VPN IP or 0.0.0.0.
SSH_USE_BIND_ADDR=127.0.0.1
SSH_USE_PORT=7443

# Local image built from this checkout; use versioned tags for upgrades.
SSH_USE_IMAGE=ssh-use:local
